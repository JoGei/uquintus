`verilator_config
// CVFPU's format tables intentionally use ascending packed ranges.
lint_off -rule ASCRANGE -file "*/fpnew_pkg.sv"
// Known upstream width conversions in the pinned package's helper functions.
// Keep width diagnostics enabled for project RTL and other imported files.
lint_off -rule WIDTHEXPAND -file "*/fpnew_pkg.sv"
// The Verilog-2005 adapter cannot express a SystemVerilog enum cast.
// DivSqrtSel uses the pinned two-bit ABI; its legal values are checked by
// elaboration guards in uqu_fpu. Keep this waiver at that language boundary.
lint_off -rule ENUMVALUE -file "*/uqu_fpu.v"
// Upstream treats the unsigned TrueSIMDClass parameter as a boolean.
lint_off -rule WIDTHTRUNC -file "*/fpnew_opgroup_fmt_slice.sv"
// Width/range conventions in the pinned upstream arithmetic implementations.
lint_off -rule WIDTHEXPAND -file "*/fpnew_rounding.sv"
lint_off -rule WIDTHEXPAND -file "*/fpnew_cast_multi.sv"
lint_off -rule WIDTHTRUNC -file "*/fpnew_cast_multi.sv"
lint_off -rule ASCRANGE -file "*/fpnew_cast_multi.sv"
lint_off -rule WIDTHEXPAND -file "*/fpnew_noncomp.sv"
lint_off -rule ASCRANGE -file "*/fpnew_fma.sv"
lint_off -rule WIDTHTRUNC -file "*/fpnew_fma.sv"
lint_off -rule WIDTHEXPAND -file "*/fpnew_fma.sv"
lint_off -rule WIDTHEXPAND -file "*/fpnew_opgroup_multifmt_slice.sv"
lint_off -rule ASCRANGE -file "*/fpnew_opgroup_multifmt_slice.sv"
lint_off -rule WIDTHEXPAND -file "*/fpnew_opgroup_fmt_slice.sv"
lint_off -rule WIDTHTRUNC -file "*/rr_arb_tree.sv"
lint_off -rule UNSIGNED -file "*/rr_arb_tree.sv"
// Version 5.020 of Verilator diagnoses different elements of a packed pipeline array as
// one mixed-assignment variable. Stage zero is continuously driven; later
// stages are flops. No individual element has both kinds of driver.
lint_off -rule BLKANDNBLK -file "*/fpnew_fma.sv"
lint_off -rule BLKANDNBLK -file "*/fpnew_cast_multi.sv"
lint_off -rule WIDTHEXPAND -file "*/pa_fpu_frbus.v"
lint_off -rule BLKANDNBLK -file "*/fpnew_opgroup_multifmt_slice.sv"
// Cocotb's public-flat visibility prevents splitting packed pipeline/tree
// arrays. Their distinct elements form acyclic stages; allow delta settling.
lint_off -rule UNOPTFLAT -file "*/fpnew_fma.sv"
lint_off -rule UNOPTFLAT -file "*/fpnew_cast_multi.sv"
lint_off -rule UNOPTFLAT -file "*/fpnew_opgroup_multifmt_slice.sv"
lint_off -rule UNOPTFLAT -file "*/rr_arb_tree.sv"
lint_off -rule UNOPTFLAT -file "*/lzc.sv"
lint_off -rule SPLITVAR -file "*/lzc.sv"
// Arbiter paths also cross the generated opgroup outputs and classifications.
lint_off -rule UNOPTFLAT -file "*/fpnew_opgroup_block.sv"
lint_off -rule UNOPTFLAT -file "*/fpnew_top.sv"
// Match the elaborated arbiter trees: generated type substitutions can lose
// their declaration's file-specific lint state in this simulator version.
lint_off -rule UNOPTFLAT -file "*rr_arb_tree.sv" -match "*u_fpnew*gen_arbiter*"
// The THMULTI packed pipeline is also public under the cocotb runner.
lint_off -rule SPLITVAR -file "*/fpnew_divsqrt_th_64_multi.sv"
lint_off -rule UNOPTFLAT -file "*/fpnew_divsqrt_th_64_multi.sv"
// Optional noncompute and TH32 staging uses those same packed stage arrays.
lint_off -rule BLKANDNBLK -file "*/fpnew_noncomp.sv"
lint_off -rule ASCRANGE -file "*/fpnew_noncomp.sv"
lint_off -rule UNOPTFLAT -file "*/fpnew_noncomp.sv"
lint_off -rule BLKANDNBLK -file "*/fpnew_divsqrt_th_32.sv"
lint_off -rule ASCRANGE -file "*/fpnew_divsqrt_th_32.sv"
lint_off -rule UNOPTFLAT -file "*/fpnew_divsqrt_th_32.sv"
